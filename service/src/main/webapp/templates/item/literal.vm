<table style="width:100%">
  <tbody>
    <tr><td>
      <div style="white-space: pre-wrap;">#escapeHTML($entity)</div>
    </td></tr>
    #if($entity.getTag())
    <tr><td>
      <small style="color:gray">Lang: $entity.getTag()</small>
    </td></tr>
    #elseif($entity.getType())
    <tr><td>
      <small style="color:gray">Datatype: #escapeIRI($entity.getType())</small>
    </td></tr>
    #end
  </tbody>
</table>
