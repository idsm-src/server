#sparql($data)
  SELECT ?NAME FROM mona: FROM dataset:ontology WHERE
  {
    $entity rdf:type / rdfs:label ?NAME.
  }
  ORDER BY DESC(langMatches(lang(?NAME), "en")) DESC(lang(?NAME) = "") DESC(str(?NAME))
  LIMIT 1
#end

<table style="width:100%">
  <tbody>
    <tr>
      #if($data.NAME)
      <td>#escapeHTML($data.NAME)</td>
      #else
      <td>$entity.getValue().replaceFirst(".*/", "")</td>
      #end
    </tr>
    <tr>
      <td><small style="color:gray">#escapeIRI($entity)<small></td>
    </tr>
  </tbody>
</table>
