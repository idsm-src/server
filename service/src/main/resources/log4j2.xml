<?xml version="1.0" encoding="UTF-8"?>
<Configuration name="Config" status="error" monitorInterval="60" shutdownHook="disable">
  <Properties>
    <!-- directory of the logs of the failed, timed out and slow SPARQL queries -->
    <Property name="queryLogs">${sys:catalina.base:-.}/logs/queries</Property>
  </Properties>
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%highlight{%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36}}%msg%n"/>
    </Console>
    <Console name="SparqlQueryConsole" target="SYSTEM_OUT">
    <PatternLayout>
      <MarkerPatternSelector defaultPattern='%d{ISO8601} %X{remoteaddr} %X{request} "%msg"%n%style{%X{sparql}}{bold}%n%X{sql}%n'>
        <PatternMatch  key="ERROR"  pattern='%d{ISO8601} %X{remoteaddr} %X{request} "%msg"%n%style{%X{sparql}}{bold}%n%X{sql}%n%throwable%n'/>
      </MarkerPatternSelector>
    </PatternLayout>
    </Console>
    <RollingFile name="QueryErrors" fileName="${queryLogs}/errors.log"
        filePattern="${queryLogs}/errors-%d{yyyy-MM}-%i.log.gz" createOnDemand="true">
      <PatternLayout pattern="%m%n%n" charset="UTF-8"/>
      <Policies>
        <TimeBasedTriggeringPolicy/>
        <SizeBasedTriggeringPolicy size="100 MB"/>
      </Policies>
      <DefaultRolloverStrategy max="20"/>
    </RollingFile>
    <RollingFile name="QueryTimeouts" fileName="${queryLogs}/timeouts.log"
        filePattern="${queryLogs}/timeouts-%d{yyyy-MM}-%i.log.gz" createOnDemand="true">
      <PatternLayout pattern="%m%n%n" charset="UTF-8"/>
      <Policies>
        <TimeBasedTriggeringPolicy/>
        <SizeBasedTriggeringPolicy size="100 MB"/>
      </Policies>
      <DefaultRolloverStrategy max="20"/>
    </RollingFile>
    <RollingFile name="QuerySlow" fileName="${queryLogs}/slow.log"
        filePattern="${queryLogs}/slow-%d{yyyy-MM}-%i.log.gz" createOnDemand="true">
      <PatternLayout pattern="%m%n%n" charset="UTF-8"/>
      <Policies>
        <TimeBasedTriggeringPolicy/>
        <SizeBasedTriggeringPolicy size="100 MB"/>
      </Policies>
      <DefaultRolloverStrategy max="20"/>
    </RollingFile>
  </Appenders>
  <Loggers>
    <Root level="error">
      <AppenderRef ref="Console"/>
    </Root>
    <Logger name="cz.iocb.sparql.engine.request.Request" level="info" additivity="false">
      <AppenderRef ref="SparqlQueryConsole"/>
    </Logger>
    <Logger name="cz.iocb.chemweb.server.filters.log.QueryLog.errors" level="info" additivity="false">
      <AppenderRef ref="QueryErrors"/>
    </Logger>
    <Logger name="cz.iocb.chemweb.server.filters.log.QueryLog.timeouts" level="info" additivity="false">
      <AppenderRef ref="QueryTimeouts"/>
    </Logger>
    <Logger name="cz.iocb.chemweb.server.filters.log.QueryLog.slow" level="info" additivity="false">
      <AppenderRef ref="QuerySlow"/>
    </Logger>
  </Loggers>
</Configuration>
