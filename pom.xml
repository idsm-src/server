<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cz.iocb.idsm</groupId>
  <artifactId>idsm</artifactId>
  <version>0.9.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>idsm</name>

  <modules>
    <module>service</module>
    <module>config</module>
    <module>loaders</module>
    <module>export</module>
  </modules>

  <properties>
    <maven.version.ignore>(?i).*-(alpha|beta|rc|b|m)([-.]?[0-9.]+)?</maven.version.ignore>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
          <configuration>
            <!-- equivalent of "javadoc -private -Xdoclint:all"; any warning fails the build -->
            <show>private</show>
            <doclint>all</doclint>
            <failOnWarnings>true</failOnWarnings>
            <quiet>true</quiet>
          </configuration>
          <executions>
            <execution>
              <id>javadoc</id>
              <phase>package</phase>
              <goals>
                <goal>javadoc</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
